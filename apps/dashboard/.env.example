# Vercel-hosted Next.js dashboard environment.
# Copy to .env.local for local development; set in Vercel project settings for prod.

# --- Supabase (us-east-1, Virginia) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key (used ONLY by app/(admin)/* routes via supabase-client-service):
SUPABASE_SERVICE_ROLE_KEY=

# --- Outbound webhook handoff settings ---
# Base64-encoded 32-byte AES key. Must match services/post-call so admin can
# encrypt tenant webhook signing secrets and post-call can decrypt them at runtime.
OUTBOUND_WEBHOOK_SECRET_ENCRYPTION_KEY=

# --- Retell AI (live voice runtime) ---
# Used by the demo page (apps/dashboard/app/demo/[demoId]) for browser-audio web-call sessions.
# Note: a SEPARATE Retell agent is provisioned for /demo/* vs production tenants — abuse on the demo
# URL must not rate-limit production paying-tenant agents (per plan U22 abuse protection).
RETELL_API_KEY=
RETELL_DEMO_AGENT_ID=

# --- Optional Cloudflare Turnstile (broadly shared /demo/[id]/connect links) ---
# Keep disabled for founder-sent demos unless the links are being distributed widely.
DEMO_TURNSTILE_REQUIRED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Vertex AI Gemini 3 Flash (post-call extraction; pinned model ID) ---
GOOGLE_APPLICATION_CREDENTIALS_JSON=
VERTEX_AI_PROJECT_ID=your-gcp-project
VERTEX_AI_LOCATION=us-central1
GEMINI_MODEL_ID=gemini-3-flash-preview

# --- Resend (transactional email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Stripe (payment links only at MVP; Checkout in v1.1) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# --- Sentry (error tracking + PII scrubbing) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Founder Slack alert (demo-session-start notifications, per plan U22) ---
FOUNDER_SLACK_WEBHOOK_URL=

# --- Demo-URL spend circuit-breaker (per plan U22 abuse protection) ---
DEMO_MONTHLY_BUDGET_USD=200
DEMO_ESTIMATED_SESSION_COST_USD=0.75
DEMO_IP_HASH_SECRET=

# Render-hosted background worker (Virginia, us-east-1).
# Receives forwarded call_ended events from services/voice, runs Gemini 3 Flash extraction,
# fans out delivery to email + Jobber + generic webhook URL.

PORT=8081
NODE_ENV=production

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Outbound webhook handoff ---
# Base64-encoded 32-byte AES key. Must match apps/dashboard so encrypted tenant
# webhook signing secrets can be decrypted only inside post-call runtime memory.
OUTBOUND_WEBHOOK_SECRET_ENCRYPTION_KEY=

# --- Internal voice -> post-call auth ---
# Must match services/voice POST_CALL_WEBHOOK_SECRET. Retell signatures are verified by services/voice.
POST_CALL_WEBHOOK_SECRET=

# --- Vertex AI Gemini 3 Flash (pinned model id; preview SLA per origin doc) ---
GOOGLE_APPLICATION_CREDENTIALS_JSON=
VERTEX_AI_PROJECT_ID=your-gcp-project
VERTEX_AI_LOCATION=us-central1
GEMINI_MODEL_ID=gemini-3.5-flash
GEMINI_FALLBACK_MODEL_ID=gemini-3-flash-preview

# --- Gemini Developer API fallback ---
# Used when GOOGLE_GENAI_API_KEY is present; set GEMINI_MODEL_ID to the primary
# Gemini API model and GEMINI_FALLBACK_MODEL_ID to a stable fallback for
# transient high-demand errors.
GOOGLE_GENAI_API_KEY=

# --- Email delivery (always-on baseline lead delivery) ---
# Supported providers: resend, brevo
POST_CALL_EMAIL_PROVIDER=resend
POST_CALL_EMAIL_FROM="RequestHandoff <leads@requesthandoff.com>"

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Brevo
BREVO_API_KEY=

# --- Sentry ---
SENTRY_DSN=

LOG_LEVEL=info

# Render-hosted always-on voice hot path (Virginia, us-east-1).
# Latency budget: p99 < 150ms on /tools/* endpoints.
# NO LLM imports allowed in src/tools/* (enforced via static-analysis check).

PORT=8080
NODE_ENV=production

# --- Supabase (service-role key — RLS bypassed; tenant_id resolved from agent_id mapping, NEVER from webhook body) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Retell webhook signature verification ---
RETELL_WEBHOOK_SECRET=

# --- Post-call worker forwarding (call_ended -> structured lead pipeline) ---
POST_CALL_WORKER_URL=http://localhost:8081
# Must match services/post-call POST_CALL_WEBHOOK_SECRET. This is internal service-to-service auth,
# separate from RETELL_WEBHOOK_SECRET.
POST_CALL_WEBHOOK_SECRET=

# --- Sentry ---
SENTRY_DSN=

# --- Logging ---
LOG_LEVEL=info
